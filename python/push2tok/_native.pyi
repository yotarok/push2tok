from os import PathLike
from typing import Literal

class FST:
    def __init__(
        self,
        transitions: list[tuple[int, int, int, list[int]]],
        finals: dict[int, list[int]],
        start_state: int = 0,
    ) -> None: ...
    @classmethod
    def from_file(
        cls, path: str | PathLike[str], *, format: Literal["binary", "const", "text"] = "binary"
    ) -> FST: ...
    def write(
        self, path: str | PathLike[str], *, format: Literal["binary", "const", "text"] = "binary"
    ) -> None: ...
    def stream(self) -> Stream: ...
    def transduce(self, data: bytes) -> list[int]: ...

class Stream:
    def push(self, data: bytes) -> list[int]: ...
    def finish(self) -> list[int]: ...
    def reset(self) -> None: ...

class BeamFST:
    @classmethod
    def from_file(
        cls, path: str | PathLike[str], *, format: Literal["binary", "const", "text"] = "binary"
    ) -> BeamFST: ...
    def stream(self, beam_width: int = 30) -> BeamStream: ...
    def transduce(self, data: bytes, *, beam_width: int = 30) -> list[int]: ...

class BeamStream:
    @property
    def pending_nodes(self) -> int: ...
    def push(self, data: bytes) -> list[int]: ...
    def finish(self) -> list[int]: ...
    def reset(self) -> None: ...
